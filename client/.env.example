# The public URL of the backend API.
# DO NOT use VITE_API_BASE_URL in the frontend build, as it causes cross-domain cookie issues on iOS Safari.
# When deployed to Cloudflare Pages, set API_BASE_URL in the Cloudflare Dashboard Environment Variables 
# so the `functions/api/[[catchall]].js` proxy knows where to forward relative `/api/*` requests.

# Show demo-account quick login and UAT setup controls in the login screen.
# Set the backend UAT_SEED_ENABLED=true as well before enabling the UAT button.
# VITE_SHOW_DEMO_ACCOUNTS=false
