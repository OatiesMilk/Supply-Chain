# Vite frontend settings: copy to client/.env for local development.
# Vite loads from client/, not the repository root or server/.env.
# Values prefixed VITE_ are public and embedded at build time. Never put secrets here.

# Disabled by default. Opt in with true ONLY for local npm run dev demos.
# Both Quick Switch and its demo guidance text stay hidden in staging/production
# builds, even when this flag is accidentally true.
VITE_SHOW_DEMO_ACCOUNTS=false

# Keep browser API requests same-origin: do not set VITE_API_BASE_URL, which can
# cause cross-domain cookie issues on iOS Safari. For Cloudflare deployment set
# API_BASE_URL as a Worker runtime variable; worker.js proxies /api/v1/* to it.
