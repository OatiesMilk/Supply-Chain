# The public URL of the backend API.
# DO NOT use VITE_API_BASE_URL in the frontend build, as it causes cross-domain cookie issues on iOS Safari.
# When deployed to Cloudflare Workers, set API_BASE_URL as a Worker runtime
# variable so the repository-root worker.js proxy knows where to forward `/api/*`.

# Show demo-account Quick Switch on the login screen. This flag does not expose
# or authorize destructive UAT/reset controls.
# VITE_SHOW_DEMO_ACCOUNTS=false
