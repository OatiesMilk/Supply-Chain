# ==============================================================================
# Supply Chain Management Portal - Environment Configuration
# ==============================================================================
# Copy this file to .env before starting the database or running the application:
#   cp .env.example .env
#
# IMPORTANT: Never commit .env with production credentials to source control.
# ==============================================================================

# ─── Database Container Configuration (Docker Compose) ───────────────────────
POSTGRES_USER=mg_portal_user
POSTGRES_PASSWORD=replace_with_a_secure_database_password
POSTGRES_DB=mg_portal
POSTGRES_PORT=5433
POSTGRES_BIND_IP=127.0.0.1

# ─── Prisma Database Connection URL ──────────────────────────────────────────
# Used by backend server, Prisma CLI, and database migrations.
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_BIND_IP}:${POSTGRES_PORT}/${POSTGRES_DB}?schema=public"

# ─── Application Authentication & Server ─────────────────────────────────────
JWT_SECRET="replace_with_a_cryptographically_secure_random_string"
PORT=4000
CLIENT_ORIGIN="http://localhost:3000"
# Relative to the server/ working directory when copied to server/.env.
POD_UPLOAD_DIR="./uploads/pod"

# ─── Microsoft Azure AD SSO (Optional) ───────────────────────────────────────
# Leave empty to use local database authentication (email + password).
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
AZURE_TENANT_ID="common"
APP_URL="http://localhost:3000"

# ─── Email / Notifications (Optional) ─────────────────────────────────────────
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Microgenesis Supply Chain Portal <no-reply@microgenesis.example>"
