{
  "compilerOptions": {
    "target": "ES2022",
    "module": "commonjs",
    "moduleResolution": "node",
    "esModuleInterop": true,
    "strict": true,
    "skipLibCheck": true,
    "lib": [
      "ES2022",
      "DOM"
    ],
    "types": [
      "node"
    ],
    "noEmit": true
  },
  "include": [
    "unit/**/*.ts",
    "api/**/*.ts",
    "browser/**/*.ts",
    "helpers/**/*.ts",
    "../automated-tests/**/*.ts",
    "*.ts"
  ]
}
