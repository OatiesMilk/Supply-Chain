{
  "name": "mg-portal-e2e",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "test:permissions": "playwright test --config permissions.config.ts",
    "test:permissions:live": "playwright test --config permissions-live.config.ts",
    "test": "playwright test --config playwright.config.ts",
    "test:sc": "playwright test --config playwright.config.ts --project=\"Sales Coordinator\"",
    "test:logistics": "playwright test --config playwright.config.ts --project=\"Logistics\"",
    "test:driver": "playwright test --config playwright.config.ts --project=\"Driver\"",
    "test:integration": "playwright test --config playwright.config.ts --project=\"Cross Role Integration\"",
    "test:headed": "playwright test --config playwright.config.ts --headed",
    "test:seeded": "playwright test --config seeded.config.ts",
    "test:seeded:list": "playwright test --config seeded.config.ts --list",
    "typecheck:seeded": "tsc --project tsconfig.seeded.json",
    "report": "playwright show-report playwright-report"
  },
  "devDependencies": {
    "@playwright/test": "^1.43.0"
  }
}
