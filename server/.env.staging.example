# Hosted staging API template. Configure these as backend service variables.
# For workstation CLI use, copy reviewed values to server/.env; the server uses
# plain dotenv and does NOT automatically load .env.staging.
# Replace every placeholder privately. Never commit the populated file.
NODE_ENV=production
APP_ENV=staging
DATABASE_URL="postgresql://staging_user:REPLACE_WITH_STAGING_PASSWORD@staging-db.example.invalid:5432/supply_chain_staging?sslmode=require"
JWT_SECRET="REPLACE_WITH_A_LONG_RANDOM_STAGING_ONLY_SECRET"
PORT=4000
CLIENT_ORIGIN="https://staging.example.invalid"
APP_URL="https://staging.example.invalid"

# Isolated private staging storage. Use the actual storage project and bucket.
POD_STORAGE_PROVIDER=supabase
SUPABASE_URL="https://staging-project.example.invalid"
SUPABASE_SERVICE_ROLE_KEY="REPLACE_WITH_STAGING_SERVICE_ROLE_KEY"
SUPABASE_STORAGE_BUCKET="pod-staging"

# Optional Microsoft SSO. Leave credentials empty to disable Microsoft login.
# Only a specific corporate tenant GUID is supported.
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
AZURE_TENANT_ID=""

# Optional mail delivery. Leave empty unless staging mail is configured.
SMTP_HOST=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM=""
RENDER_EXTERNAL_URL="https://staging-api.example.invalid"

# Request security. Set the same PROXY_SHARED_SECRET on the API and Worker.
# Keep REQUIRE_PROXY_SECRET=false until both sides are configured; enable true
# afterward when the API should accept requests only through that Worker.
TRUSTED_ORIGINS=""
PROXY_SHARED_SECRET=""
REQUIRE_PROXY_SECRET=false
# Without the Worker secret, set only the verified number of trusted proxy hops.
TRUST_PROXY=""

# Destructive local demo resets remain disabled on staging.
LOCAL_DESTRUCTIVE_SEED=false

# Optional guarded staging seed CLI settings, not startup/deployment actions.
# See docs/staging-seed.md before supplying confirmations or running a preview.
# STAGING_SEED_DATABASE=supply_chain_staging
# STAGING_SEED_HOST=staging-db.example.invalid
# STAGING_SEED_ADMIN_EMAIL=existing-admin@example.invalid
# STAGING_SEED_DATA_APPROVED=false
# STAGING_SEED_ALLOW_RESET=false
