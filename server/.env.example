# Local development: copy this file to server/.env and fill in real values.
# Hosted staging: use .env.staging.example and docs/STAGING_CONFIGURATION.md.
# VITE_* frontend flags belong in client/.env* or the frontend build environment.

# ─── Database ────────────────────────────────────────────────────────────────
# Keep this URL literal. Prisma and plain dotenv do not expand ${...} references.
DATABASE_URL="postgresql://mg_portal_user:replace_with_a_secure_database_password@127.0.0.1:5433/mg_portal?schema=public"

# ─── Auth ────────────────────────────────────────────────────────────────────
JWT_SECRET="change-me-to-a-long-random-string"

# ─── Server ──────────────────────────────────────────────────────────────────
PORT=4000
CLIENT_ORIGIN="http://localhost:3000"
POD_UPLOAD_DIR="./uploads/pod"
# Private folder where an upload is held while it is checked (SEC-07). Defaults
# to the OS temp folder; it must not be inside POD_UPLOAD_DIR or web-served.
# POD_TEMP_DIR=""
# Must be exactly "local" or "supabase"; any other value stops the server at
# startup. "local" keeps files in POD_UPLOAD_DIR, which must be on a persistent
# disk in a deployed environment or uploads are lost on restart.
POD_STORAGE_PROVIDER="local"
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""
SUPABASE_STORAGE_BUCKET="pod"

# ─── Microsoft Azure AD SSO (optional) ──────────────────────────────────────
AZURE_CLIENT_ID=""
AZURE_CLIENT_SECRET=""
# Required for SSO: specific corporate tenant GUID. Never use common/organizations/consumers.
# Microsoft login is disabled until a valid tenant GUID and client credentials are provided.
AZURE_TENANT_ID=""
APP_URL="http://localhost:3000"

# ─── Email ───────────────────────────────────────────────────────────────────
SMTP_HOST=""
# Exact email of the approved active portal user who receives collection billing
# notifications. Current record-read permission is required in both permission modes.
# Missing/denied mappings are logged as SKIPPED; no placeholder email is sent.
BILLING_NOTIFICATION_USER_EMAIL=""
SMTP_PORT=587
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Microgenesis Supply Chain Portal <no-reply@microgenesis.example>"
# The public URL of the backend API (used for self-ping to prevent Render sleep)
RENDER_EXTERNAL_URL=""

# Destructive CLI seed commands default to DENIED. Only a verified local disposable
# *_sandbox or *_test database is eligible. Never set these on staging/production.
# NODE_ENV=development
# LOCAL_DESTRUCTIVE_SEED=false
# LOCAL_SEED_DATABASE=mg_portal_sandbox

# ─── Request security (AUD-003) ──────────────────────────────────────────────
# Writes are accepted only from CLIENT_ORIGIN, APP_URL and these extra origins
# (comma-separated, e.g. a staging frontend). Leave empty if there are none.
TRUSTED_ORIGINS=
# Secret shared with the Cloudflare Worker (set the same value as a Worker
# secret). With it, rate limits use the real visitor address the Worker forwards.
PROXY_SHARED_SECRET=
# "true" makes the API refuse every /api/v1 request that does not carry the Worker
# secret, so it cannot be reached at its own address. GET /api/v1/health stays
# open for the host's health check. Leave empty for local development. Turn on
# only after PROXY_SHARED_SECRET is set on both the Worker and the API; the
# server will not start with this on and the secret empty.
REQUIRE_PROXY_SECRET=
# Only when the API is reached through a reverse proxy WITHOUT the Worker secret:
# number of trusted proxy hops in front of Express. Leave empty otherwise.
TRUST_PROXY=
