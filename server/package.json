{
  "name": "mg-portal-server",
  "private": true,
  "version": "0.0.1",
  "type": "commonjs",
  "scripts": {
    "test": "node --import tsx --test tests/*.test.ts",
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/src/index.js",
    "prisma:validate": "prisma validate",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev --name init",
    "seed": "tsx prisma/seed.ts",
    "seed:users-only": "tsx prisma/seed-users-only.ts",
    "seed:driver-demo": "tsx prisma/seed-driver-demo.ts",
    "seed:uat": "tsx prisma/seed-uat.ts",
    "seed:staging": "tsx prisma/seed-staging.ts",
    "seed:staging:reset": "tsx prisma/seed-staging.ts --reset",
    "lint": "tsc --noEmit",
    "db:reset": "prisma migrate reset --force",
    "seed:accounts": "tsx prisma/seed-accounts-only.ts",
    "pod:reconcile": "tsx prisma/reconcile-pod-files.ts",
    "drivers:import": "tsx prisma/import-historical-drivers.ts",
    "drivers:identity-report": "tsx prisma/report-driver-identity.ts",
    "drivers:migrate-coverage": "tsx prisma/migrate-driver-coverage.ts",
    "db:clean": "prisma migrate reset --force",
    "permissions:backfill": "tsx prisma/backfill-permissions.ts",
    "permissions:provision-local": "tsx prisma/provision-local-permissions.ts",
    "permissions:activate-rma-dispatch": "tsx prisma/activate-rma-dispatch.ts",
    "permissions:rehearse": "tsx prisma/rehearse-permissions.ts"
  },
  "dependencies": {
    "@asteasolutions/zod-to-openapi": "^9.1.0",
    "@azure/identity": "^4.13.1",
    "@azure/msal-node": "^5.5.0",
    "@microsoft/microsoft-graph-client": "^3.0.7",
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "bcryptjs": "^2.4.3",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.2",
    "express-rate-limit": "^8.7.1",
    "helmet": "^8.3.0",
    "jsonwebtoken": "^9.0.2",
    "mammoth": "^1.13.0",
    "morgan": "^1.12.1",
    "multer": "^2.4.0",
    "nodemailer": "^6.9.15",
    "pg": "^8.23.0",
    "sanitize-html": "^2.18.1",
    "sharp": "^0.35.5",
    "swagger-jsdoc": "^6.3.0",
    "swagger-ui-express": "^5.0.1",
    "tsx": "^4.21.0",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.7",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.14.0",
    "@types/nodemailer": "^6.4.16",
    "@types/pg": "^8.23.1",
    "@types/sanitize-html": "^2.16.2",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "autocannon": "^8.0.0",
    "prisma": "^7.10.0",
    "typescript": "~5.8.2"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
}
